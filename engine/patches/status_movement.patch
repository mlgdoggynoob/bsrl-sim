+    }
+    w->spare = w->mount ? sk[0] : NULL; sk[0] = inst; g_nswap++;
+    if (g_superfix_dbg) LOG("[superfix] cc: weapon %s ch %d -> skill %d, tick %d\n", w->mount ? "mount" : "dismount", I32(ch, 8),
+                            I32(w->want, 0x20), now_tick(ch));
