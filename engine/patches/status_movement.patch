+    for (k = 0; k < g_nblk && !(g_blk[k].ch == ch && g_blk[k].id == I32(ch, 8)); k++) {}
+    if (blocked && k == g_nblk) {   /* a new stun: stop the path the character is on (the mover only refuses new moves) */
+        if (g_nblk < BLK_MAX) g_blk[g_nblk++] = (Blk){ch, I32(ch, 8)};
