 typedef struct Gad Gad;
 typedef struct {
@@ -61,9 +72,10 @@ typedef struct {
 struct Gad {
     int card, uses, cd, cd_until, used; void *ad; const GadImpl *im;
     int hot_id, hot_start, hot_end, hot_total, hot_done;   /* heal over time: char id, ticks, hp to give, hp given */
