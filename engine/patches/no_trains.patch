# Survival651's trains off behind a flag, a diff on top of the other patches (after hyper_unmodelled.patch). Paths relative
# to engine/. env.c: NB_NO_TRAINS=1 replaces libg's train creation call (0xc2f570 bl 0xc2fc14) with a no-op; off by default.
diff --git a/native/loader/env.c b/native/loader/env.c
index bcae502..92439a3 100644
--- a/native/loader/env.c
+++ b/native/loader/env.c
@@ -2919,6 +2919,12 @@ void hits_dump(const char *why) {
     for (int i = 0; i < g_nhit; i++) if (g_hits[i] - g_hits0[i]) LOG(" %lx=%ld", (unsigned long)g_hit_addr[i], g_hits[i] - g_hits0[i]);
     LOG("\n");
 }
+/* Survival651's trains: at battle start libg places Train0-3 characters (characters.csv 16000277 / 303 / 304 / 305, Type Train,
+ * hp 1, CollisionRadius 200) on the map's PayloadTrack: 0xc2f570 bl 0xc2fc14, its one caller, gated by the mode check 0xc2f564.
+ * On the host they never move or die, brawlers walk through them and they are not in state2 or the observation, but
+ * projectile collision (0xb70d94) stops on them, so they act as invisible walls for shots. NB_NO_TRAINS=1 skips the
+ * creation call (the code after it reads no result of it); off by default, which keeps the trains (the earlier host). */
+static void no_trains(void *battle) { (void)battle; }
 void env_install(void) {
     if (!g_env_on) return;
     KIND_BY_TYPE = B(0x185710);
@@ -2950,6 +2956,10 @@ void env_install(void) {
     o_b29350 = hook_replace(g_libg, 0xb29350, my_b29350);   /* diversity round: null-owner guard */
     o_alive = hook_replace(g_libg, 0xc42ae8, my_alive);
     o_dispatch = hook_replace(g_libg, 0xb47084, my_dispatch);
+    if (getenv("NB_NO_TRAINS") && atoi(getenv("NB_NO_TRAINS"))) {
+        if (*(uint32_t *)B(0xc2f570) == 0x940001a9) hook_bl(g_libg, 0xc2f570, (void *)no_trains);   /* bl 0xc2fc14 */
+        else LOG("[env] 0xc2f570: not the train creation call, trains left in\n");
+    }
     hyper_install();   /* hypercharge round: Character::isOvercharged (hyper.c) */
     gear_install();    /* gear round (issue #51): NB_GEARS */
     if (!g_env_simonly) {
