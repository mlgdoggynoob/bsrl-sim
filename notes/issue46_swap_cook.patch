+/* ---- SUMMON (issue #46 batch 4): spawn rows whose CustomObject is a characters.csv row and SubType 1 (BeeSniper_Slow's pot,
+ * Roller_Speed's booster, CrossBomber_Vision's tower, JetpackGirl_DamageTower: one summon at the brawler, no other column).
+ * The Attack handler hands a skill's summon to its projectile (setter 0xb703c8(proj, CharacterData, count, ...): +0x1c0 the
+ * CharacterData, +0x3e8 the count) and the projectile's end spawns it (0xb75b00 -> 0xb77344 -> the character factory
+ * 0xb56e00: position = the projectile's, count 1 = no ring offset, power level / owner / team from the projectile). The same
+ * is done here with a carrier projectile of the brawler's own weapon (dmg 0) aimed at the brawler's own tile, so the
+ * projectile ends at once and the game's own code spawns the summon; the summon's area (CharacterData AreaEffect), lifetime
+ * and AI are then libg's and superfix_summon_area's. The other spawn SubTypes (2..6: counts, rings, pets with CustomValues
+ * 20..400 of unknown meaning) and ArtilleryDude_Cover (CustomValue1 35) are not read: not usable. */
+#define AD_SUBTYPE_SPAWN_ONE 1
+static long g_summons;
+static void *custom_char(void *ad) { return lookup_by_name(0xad2b60, ((void *(*)(void *))B(AD_CUSTOM_OBJ))(ad)); }   /* 0xad2b60 getCharacterByName */
+static int summon_classify(void *ad, int type) {
+    return type == ACC_SPAWN && ad_get(ad, AD_SUBTYPE) == AD_SUBTYPE_SPAWN_ONE && !custom_item(ad) && !PTR(ad, AD_AREA) &&
+           !ad_get(ad, AD_CV1) && !ad_get(ad, AD_CV2) && custom_char(ad);
+}
+static int summon_fire(void *sim, Gad *g, uint8_t *ch, double deg, int tick) {
+    (void)deg; (void)tick;
+    if (I32(ch, 0x3c4) <= 0 || !PTR(ch, 0x20)) return 0;
+    void *sd = SKILL_ATTACK_SD(ch), *pd = skill_proj(sd);
+    if (!pd) return 0;
+    int X = I32(ch, 0x38), Y = I32(ch, 0x3c);
+    uint8_t *p = ((SpawnProj)B(0xb78190))(X, Y, ch, ch, pd, X, Y, 0, 0, 0, 0, NULL, sim, 0, GAD_PROJ_KIND, NULL);
+    if (!p) return 0;
+    PTR(p, 0x1c0) = custom_char(g->ad); I32(p, 0x3e8) = 1;   /* setter 0xb703c8: CharacterData, count (+0x3ec, +0x3f4, +0x3f8 stay 0) */
+    g_summons++;
+    if (g_summons <= 6) LOG("[gadget] summon carrier %p for char data %d\n", p, I32(PTR(p, 0x1c0), 0x20));
+    return 1;
+}
+
+/* ---- SWAP (issue #46 batch 4): swap_weapon_skill with a bounded duration (Alternator's two modes: ActiveTicks 100 = 5 s,
+ * CustomObject = the replacement weapon SkillData, AreaEffect = the mode's aura). The weapon swap is superfix_cc.c's (Draco's
+ * mount: a new skill instance in slot 0, the old one kept and put back), done at the use and undone ActiveTicks later; the aura
+ * is spawned at the brawler as for the AREA kind. Voodoo_AllBuffsAttack and Meeple_WallAttack (ActiveTicks 100000, CustomValue6
+ * 1: how long the swap lasts is not in the row) are left out. */
+extern void superfix_cc_swap(uint8_t *ch, void *data, int mount) __attribute__((weak));
+static long g_swaps;
+static void *custom_skill(void *ad) { return lookup_by_name(0xad2b7c, ((void *(*)(void *))B(AD_CUSTOM_OBJ))(ad)); }   /* 0xad2b7c getSkillByName */
+static int swap_classify(void *ad, int type) {
+    int t = ad_get(ad, AD_ACTIVE_TICKS);
+    return type == ACC_SWAP && superfix_cc_swap && t > 0 && t < 10000 && custom_skill(ad) && PTR(ad, AD_AREA);
+}
+static void *own_weapon(uint8_t *ch) { uint8_t *cd = ((uint8_t *(*)(void *))B(0xb6a384))(ch); return cd ? PTR(cd, 0x260) : NULL; }   /* CharacterData +0x260 (superfix_cc.c) */
+static int swap_fire(void *sim, Gad *g, uint8_t *ch, double deg, int tick) {
+    if (I32(ch, 0x3c4) <= 0 || g->swap_end) return 0;
+    void *sd = custom_skill(g->ad); if (!sd) return 0;
+    superfix_cc_swap(ch, sd, 1);
+    g->swap_id = I32(ch, 8); g->swap_end = tick + ad_get(g->ad, AD_ACTIVE_TICKS); g->swap_sd = sd; g_swaps++;
+    area_fire(sim, g, ch, deg, tick);   /* the mode's aura at the brawler (an AreaEffect row, spawned as the AREA kind does) */
+    return 1;
+}
+static void swap_tick(void *sim, Gad *g, int tick) {
+    uint8_t *ch = env_obj_by_id(sim, g->swap_id);
+    if (tick < g->swap_end && ch && I32(ch, 0x3c4) > 0) return;
+    if (ch && I32(ch, 0x3c4) > 0 && own_weapon(ch)) superfix_cc_swap(ch, own_weapon(ch), 0);
+    g->swap_end = 0;
+}
+
+/* ---- COOK (issue #46 batch 4): next_attack_change SubType 23 (Cooker_Poison, "next basic attack shoots burning cookies, dealing
+ * extra damage over time"): the row's StatusEffectEnemy (AccessoryData +0x60, createReferences 0xa92474's store order: Ally
+ * +0x58, Enemy +0x60, Self +0x68, AreaEffect +0x70) is CookerGadgetDot (status_effects_logic.csv: Damage every TriggerRate
+ * ticks for DurationTicks). The client code only reads the armed accessory and calls the compiled-out stub 0xb27cfc, so the
+ * host does it: the use arms it, the projectile spawn 0xb78190 (wrapped in gadget_install) tags the main-attack projectiles
+ * (kind word 1) the owner spawns in the first tick it spawns any, and the damage root (env.c, gadget_hit) gives an enemy
+ * the status when a tagged projectile hits it, through the status add 0xb35dd0 superfix_status.c runs (its damage ticks
+ * through the root as every status). Cooker_Healing (SubType 24: the cookies ignore enemies and heal allies, StatusEffectAlly)
+ * is not done: the projectile's pass-through of enemies is server code. */
+static long g_cooks; static int g_cooks_live;
+static int cook_classify(void *ad, int type) { return type == 23 /* next_attack_change */ && g_cooks_live && ad_get(ad, AD_SUBTYPE) == 23 && PTR(ad, 0x60); }
+static int cook_fire(void *sim, Gad *g, uint8_t *ch, double deg, int tick) {
+    (void)sim; (void)deg;
+    if (I32(ch, 0x3c4) <= 0 || g->cook_armed) return 0;
+    g->cook_armed = tick > 0 ? tick : 1; g->cook_tag_tick = 0; g->cook_ntag = 0;
+    return 1;
+}
+typedef void *(*SpawnProj16)(int, int, void *, void *, void *, int, int, int, int, int, int, void *, void *, int, int, void *);
+static SpawnProj16 g_spawn_orig;
+static void *my_spawn_proj(int x, int y, void *o1, void *o2, void *pd, int tx, int ty, int d1, int d2, int a9, int a10, void *a11,
+                           void *sim, int a13, int kind, void *a15) {
+    void *p = g_spawn_orig(x, y, o1, o2, pd, tx, ty, d1, d2, a9, a10, a11, sim, a13, kind, a15);
+    if (p && kind == 1 && sim && o1) {
+        int now = I32(sim, 0x10);
+        for (int i = 0; i < NBE_MAXP; i++) {
+            Gad *g = &g_gad[i]; if (!g->cook_armed || !g->im || g->im->fire != cook_fire) continue;
+            uint8_t *ch = char_of(sim, i); if (ch != (uint8_t *)o1) continue;
+            if (!g->cook_tag_tick) g->cook_tag_tick = now;
+            if (g->cook_tag_tick == now && g->cook_ntag < 16) { g->cook_tag[g->cook_ntag][0] = I32(p, 8); g->cook_tag[g->cook_ntag++][1] = -1; }
+        }
+    }
+    return p;
+}
+typedef void (*apply_t)(void *, void *, int, int, void *, void *, int, int, int, int, int);   /* 0xb35dd0 (superfix_status.c) */
+void gadget_hit(void *victim, void *attacker, void *src) {   /* env.c's damage root hook: a tagged cookie hits an enemy */
+    static int off = -1; if (off < 0) off = getenv("NB_GAD_COOK_OFF") != NULL;   /* NB_GAD_COOK_OFF=1: no status (the audit's control run) */
+    if (!victim || !src || !g_cooks_live || off) return;
+    for (int i = 0; i < NBE_MAXP; i++) {
+        Gad *g = &g_gad[i]; if (!g->cook_ntag) continue;
+        int pid = I32(src, 8);
+        for (int k = 0; k < g->cook_ntag; k++) {
+            if (g->cook_tag[k][0] != pid || g->cook_tag[k][1] == I32(victim, 8)) continue;
+            int pl = ((int (*)(void *))B(0xb6a754))(src), team = ((int (*)(void *))B(0xb6a818))(src), vt = ((int (*)(void *))B(0xb6a818))(victim);
+            if (vt == team) continue;   /* allies are not poisoned */
+            g->cook_tag[k][1] = I32(victim, 8);
+            ((apply_t)B(0xb35dd0))(victim, PTR(g->ad, 0x60), pl, team, src, attacker, 0, 0, -1, -1, 0);
+            g_cooks++;
+            if (g_cooks <= 6) LOG("[gadget] cook: status %p on char %d from projectile %d\n", PTR(g->ad, 0x60), I32(victim, 8), pid);
+        }
+    }
+}
+static void cook_tick(Gad *g, int tick) { if (g->cook_armed && g->cook_tag_tick && tick > g->cook_tag_tick) g->cook_armed = 0; }
